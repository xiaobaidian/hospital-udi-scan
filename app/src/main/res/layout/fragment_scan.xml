<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 模式切换：扫码 | 扫码枪 -->
    <LinearLayout
        android:id="@+id/mode_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mode_toggle"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_mode_camera"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:gravity="center"
            android:background="@null"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="6dp"
            android:text="@string/mode_camera"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/btn_mode_gun"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:gravity="center"
            android:background="@null"
            android:drawableStart="@drawable/ic_scan_gun"
            android:drawablePadding="6dp"
            android:text="@string/mode_gun"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />
    </LinearLayout>

    <!-- 扫码取景 -->
    <FrameLayout
        android:id="@+id/frame_camera"
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcode_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 扫码引导提示条：填充取景框上方空白，不占用系统状态栏 -->
        <TextView
            android:id="@+id/scan_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#33000000"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="将镜头对准条码 / 二维码，自动识别"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 取景框引导层：四角 + 中心框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no">

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/scan_frame" />

            <View
                android:layout_width="match_parent"
                android:layout_height=" 0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 扫码识别反馈条：默认隐藏（保留此层，去掉底部常驻提示层） -->
        <TextView
            android:id="@+id/scan_flash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 扫码枪输入卡（仅扫码枪模式显示） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_gun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:cardElevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_scan_gun"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/mode_gun"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <TextView
                    android:id="@+id/tv_gun_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gun_status_wait"
                    android:textSize="12sp"
                    android:textColor="@color/ok" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_gun_input"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_qty"
                android:textSize="18sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:textColor="@color/text_main"
                android:hint="@string/gun_input_hint"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/gun_connect_hint"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 本批计数卡（仅扫码枪模式显示） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:cardElevation="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/batch_count_title"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub" />

                <TextView
                    android:id="@+id/tv_batch_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_reset_count"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="@string/btn_reset_count"
                android:textSize="13sp"
                android:textColor="@color/primary"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 查询结果（型号/名称）醒目横条：置于待录入上方，更直观 -->
    <TextView
        android:id="@+id/tv_product_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_product_top"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 解析前拼接的原始扫码串（UDI 优先排序；扫码前隐藏，扫到码再展示） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_raw_dump"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#FFF8E1"
        app:cardElevation="3dp"
        app:strokeColor="#FFB300"
        app:strokeWidth="2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/raw_dump_title"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#E65100" />

            <TextView
                android:id="@+id/tv_raw_dump"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="@color/text_main"
                android:typeface="monospace" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 「本次将录入」实时预览卡（紧凑，字段分行，保留浅蓝底） -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#E3F2FD"
        app:cardElevation="4dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- 标题行：左标题 + 右「自定义字典」按钮（仅扫到 UDI 显示） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/preview_title"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/primary_dark" />

                <Button
                    android:id="@+id/btn_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="34dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="6dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:text="@string/btn_accept"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="#66BB6A"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_edit_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="34dp"
                    android:paddingHorizontal="12dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:text="@string/btn_custom_dict"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="#FCE4EC"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- UDI 一行（背景比卡片 #E3F2FD 更淡，避免与卡片同色） -->
            <TextView
                android:id="@+id/tv_line_udi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:background="#CFE8FB"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 批号 一行 -->
            <TextView
                android:id="@+id/tv_line_batch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:background="#E8F5E9"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 效期 一行 -->
            <TextView
                android:id="@+id/tv_line_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:background="#FFF3E0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 生产 一行 -->
            <TextView
                android:id="@+id/tv_line_prod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:background="#F3E5F5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 序列号 一行（空则隐藏） -->
            <TextView
                android:id="@+id/tv_line_serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:visibility="gone"
                android:background="#FCE4EC"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- 数量：减号 + 输入框 + 加号（步进按钮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数量："
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <Button
                    android:id="@+id/btn_qty_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    app:backgroundTint="@color/primary" />

                <EditText
                    android:id="@+id/et_qty"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:background="@drawable/bg_qty"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="6dp"
                    android:text="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <Button
                    android:id="@+id/btn_qty_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:text="＋"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>

            <!-- 未识别/待确认提示 -->
            <TextView
                android:id="@+id/tv_preview_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 操作区（查询 / 改名 / 加入 / 丢弃）—— 移除与预览卡重复的缓冲原文展示 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="操作"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_main" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_query"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/btn_query"
                    android:textColor="#ffffff"
                    app:backgroundTint="@color/btn_query_green" />

                <Button
                    android:id="@+id/btn_add"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/btn_add"
                    android:textColor="#ffffff"
                    app:backgroundTint="@color/primary" />

                <Button
                    android:id="@+id/btn_discard"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/btn_discard" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
